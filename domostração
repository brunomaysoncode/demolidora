<div class="chat-bubble" onclick="toggleChat()">🤖</div>
<div class="chat-panel" id="chatPanel">
  <div class="chat-header">
    <div class="chat-av">🤖</div>
    <div>
      <div class="chat-title">IA NewCiclo</div>
      <div class="chat-status">● Online agora</div>
    </div>
  </div>
  <div class="chat-body" id="chatBody">
    <div class="chat-msg bot">Olá! Sou a IA da NewCiclo. Posso ajudar com precificação, captação de materiais, contratos e estratégia comercial. O que você precisa?</div>
  </div>
  <div class="chat-input-row">
    <input class="chat-input" id="chatInput" placeholder="Pergunte sobre materiais, margens..." onkeydown="if(event.key==='Enter')sendChat()">
    <button class="chat-send" onclick="sendChat()">→</button>
  </div>
</div>

<script>
const reveals = document.querySelectorAll('.reveal');
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.1 });
reveals.forEach(r => observer.observe(r));

function setActive(el) {
  document.querySelectorAll('.sidebar-item').forEach(i => i.classList.remove('active'));
  el.classList.add('active');
}

function startTimer(hEl, mEl, sEl, h, m, s) {
  let total = h*3600 + m*60 + s;
  setInterval(() => {
    if (total <= 0) return;
    total--;
    document.getElementById(hEl).textContent = String(Math.floor(total/3600)).padStart(2,'0');
    document.getElementById(mEl).textContent = String(Math.floor((total%3600)/60)).padStart(2,'0');
    document.getElementById(sEl).textContent = String(total%60).padStart(2,'0');
  }, 1000);
}
startTimer('t1h','t1m','t1s',2,47,33);

let chatOpen = false;
function toggleChat() {
  chatOpen = !chatOpen;
  document.getElementById('chatPanel').classList.toggle('open', chatOpen);
}

const botResponses = [
  "Para madeiras nobres como Cumaru, a margem média é de 35–65% em São Paulo. O preço de demolição gira entre R$40–60/m², e o de revenda para arquitetos entre R$100–180/m².",
  "Para intermediar sem estoque, o mais importante é o Termo de Autorização de Anúncio com cláusula anti-bypass. Posso gerar esse contrato para você agora.",
  "O RFM indica que arquitetos têm ticket médio 3× maior que clientes finais. Priorize esse público para aumentar a margem por operação.",
  "Leilões extrajudiciais oferecem os melhores descontos — em média 60–70% abaixo do valor de mercado. A plataforma tem integração com os principais portais.",
  "Para validar demanda sem estoque: crie o anúncio primeiro, capte intenção de compra com sinal, depois feche com o fornecedor. Isso é pré-venda com risco zero.",
];
let botIdx = 0;

function sendChat() {
  const input = document.getElementById('chatInput');
  const body = document.getElementById('chatBody');
  const msg = input.value.trim();
  if (!msg) return;
  body.innerHTML += `<div class="chat-msg user">${msg}</div>`;
  input.value = '';
  setTimeout(() => {
    body.innerHTML += `<div class="chat-msg bot">${botResponses[botIdx % botResponses.length]}</div>`;
    botIdx++;
    body.scrollTop = body.scrollHeight;
  }, 800);
  body.scrollTop = body.scrollHeight;
}
</script>

</body>

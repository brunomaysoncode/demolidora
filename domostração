<!DOCTYPE html>

<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NewCiclo — Plataforma de Materiais de Demolição</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,300&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  --verde: #1a7a3c;
  --verde-escuro: #0d4f26;
  --verde-neon: #2dce5c;
  --carvao: #111410;
  --concreto: #2a2e27;
  --areia: #c8b89a;
  --areia-clara: #e8dcc8;
  --branco: #f4f2ec;
  --laranja: #d4622a;
  --amarelo: #e8b84b;
  --cinza: #7a8070;
  --cinza-claro: #b8bfb0;
  --superficie: #1c201a;
  --card: #222620;
  --borda: #333830;
}

- { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
font-family: ‘DM Sans’, sans-serif;
background: var(–carvao);
color: var(–branco);
overflow-x: hidden;
}

/* SCROLLBAR */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: var(–carvao); }
::-webkit-scrollbar-thumb { background: var(–verde); border-radius: 2px; }

/* NAV */
nav {
position: fixed; top: 0; left: 0; right: 0; z-index: 100;
display: flex; align-items: center; justify-content: space-between;
padding: 18px 48px;
background: rgba(17,20,16,0.92);
backdrop-filter: blur(20px);
border-bottom: 1px solid rgba(45,206,92,0.1);
}

.nav-logo {
display: flex; align-items: center; gap: 10px;
font-family: ‘Bebas Neue’; font-size: 26px; letter-spacing: 2px;
color: var(–branco);
}

.nc-badge {
width: 36px; height: 36px;
background: var(–verde);
border-radius: 8px;
display: flex; align-items: center; justify-content: center;
font-size: 14px; font-family: ‘Space Mono’; font-weight: 700;
color: white;
}

.nav-links { display: flex; gap: 32px; align-items: center; }
.nav-links a {
color: var(–cinza-claro); text-decoration: none;
font-size: 13px; font-weight: 500; letter-spacing: 0.5px;
transition: color 0.2s;
}
.nav-links a:hover { color: var(–verde-neon); }

.nav-cta {
background: var(–verde); color: white !important;
padding: 8px 20px; border-radius: 6px;
font-weight: 700 !important;
transition: background 0.2s !important;
}
.nav-cta:hover { background: var(–verde-escuro) !important; }

/* HERO */
.hero {
min-height: 100vh;
display: flex; flex-direction: column; justify-content: center;
padding: 120px 48px 80px;
position: relative; overflow: hidden;
}

.hero-bg {
position: absolute; inset: 0;
background:
radial-gradient(ellipse 80% 60% at 70% 50%, rgba(26,122,60,0.12) 0%, transparent 60%),
radial-gradient(ellipse 40% 40% at 20% 80%, rgba(212,98,42,0.08) 0%, transparent 50%),
repeating-linear-gradient(0deg, transparent, transparent 60px, rgba(255,255,255,0.01) 60px, rgba(255,255,255,0.01) 61px),
repeating-linear-gradient(90deg, transparent, transparent 60px, rgba(255,255,255,0.01) 60px, rgba(255,255,255,0.01) 61px);
}

.hero-tag {
display: inline-flex; align-items: center; gap: 8px;
background: rgba(45,206,92,0.1);
border: 1px solid rgba(45,206,92,0.3);
padding: 6px 14px; border-radius: 20px;
font-size: 12px; font-weight: 700; letter-spacing: 1px;
color: var(–verde-neon); text-transform: uppercase;
margin-bottom: 24px; width: fit-content;
animation: fadeUp 0.6s ease both;
}

.pulse-dot {
width: 6px; height: 6px; border-radius: 50%;
background: var(–verde-neon);
animation: pulse 1.5s ease infinite;
}

@keyframes pulse {
0%, 100% { opacity: 1; transform: scale(1); }
50% { opacity: 0.5; transform: scale(0.7); }
}

.hero-title {
font-family: ‘Bebas Neue’;
font-size: clamp(64px, 9vw, 130px);
line-height: 0.92;
letter-spacing: -1px;
color: var(–branco);
animation: fadeUp 0.6s 0.1s ease both;
max-width: 900px;
}

.hero-title span { color: var(–verde-neon); }
.hero-title em { font-style: normal; color: var(–areia); }

.hero-sub {
font-size: 17px; font-weight: 300; color: var(–cinza-claro);
max-width: 560px; line-height: 1.7;
margin-top: 28px;
animation: fadeUp 0.6s 0.2s ease both;
}

.hero-actions {
display: flex; gap: 16px; align-items: center;
margin-top: 44px;
animation: fadeUp 0.6s 0.3s ease both;
}

.btn-primary {
background: var(–verde);
color: white; border: none; cursor: pointer;
padding: 14px 32px; border-radius: 8px;
font-family: ‘DM Sans’; font-size: 15px; font-weight: 700;
letter-spacing: 0.5px;
transition: all 0.2s;
display: flex; align-items: center; gap: 8px;
}
.btn-primary:hover { background: var(–verde-neon); color: var(–carvao); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(45,206,92,0.3); }

.btn-ghost {
background: transparent; color: var(–branco);
border: 1px solid var(–borda); cursor: pointer;
padding: 14px 28px; border-radius: 8px;
font-family: ‘DM Sans’; font-size: 15px; font-weight: 500;
transition: all 0.2s;
}
.btn-ghost:hover { border-color: var(–verde); color: var(–verde-neon); }

.hero-stats {
display: flex; gap: 48px; margin-top: 72px;
animation: fadeUp 0.6s 0.4s ease both;
}

.stat-item { display: flex; flex-direction: column; gap: 4px; }
.stat-num {
font-family: ‘Bebas Neue’; font-size: 38px; color: var(–verde-neon);
letter-spacing: 1px;
}
.stat-label { font-size: 12px; color: var(–cinza); font-weight: 500; text-transform: uppercase; letter-spacing: 0.8px; }

.hero-float {
position: absolute; right: 48px; top: 50%; transform: translateY(-50%);
display: flex; flex-direction: column; gap: 16px;
animation: fadeLeft 0.8s 0.5s ease both;
}

@keyframes fadeLeft {
from { opacity: 0; transform: translateY(-50%) translateX(40px); }
to { opacity: 1; transform: translateY(-50%) translateX(0); }
}

.float-card {
background: var(–card);
border: 1px solid var(–borda);
border-radius: 12px;
padding: 20px;
width: 280px;
}

.float-card-title {
font-size: 11px; font-weight: 700; letter-spacing: 1px;
color: var(–cinza); text-transform: uppercase; margin-bottom: 14px;
}

.material-item {
display: flex; align-items: center; gap: 12px;
padding: 10px 0;
border-bottom: 1px solid var(–borda);
}
.material-item:last-child { border-bottom: none; }

.mat-icon {
width: 36px; height: 36px; border-radius: 8px;
display: flex; align-items: center; justify-content: center;
font-size: 18px; flex-shrink: 0;
}

.mat-info { flex: 1; }
.mat-name { font-size: 13px; font-weight: 600; color: var(–branco); }
.mat-detail { font-size: 11px; color: var(–cinza); margin-top: 2px; }
.mat-price { font-family: ‘Space Mono’; font-size: 13px; color: var(–verde-neon); font-weight: 700; }

/* SECTION */
section { padding: 100px 48px; }

.section-tag {
font-size: 11px; font-weight: 700; letter-spacing: 2px;
color: var(–verde-neon); text-transform: uppercase; margin-bottom: 16px;
}

.section-title {
font-family: ‘Bebas Neue’;
font-size: clamp(40px, 5vw, 72px);
line-height: 1; color: var(–branco);
margin-bottom: 20px;
}

.section-sub {
font-size: 16px; color: var(–cinza-claro);
line-height: 1.7; max-width: 600px;
}

/* COMO FUNCIONA */
.how-section { background: var(–superficie); }

.how-grid {
display: grid; grid-template-columns: repeat(3, 1fr);
gap: 2px; margin-top: 64px;
border: 2px solid var(–borda); border-radius: 16px; overflow: hidden;
}

.how-card {
background: var(–card);
padding: 44px 36px;
transition: background 0.3s;
cursor: default;
}
.how-card:hover { background: rgba(26,122,60,0.15); }

.how-num {
font-family: ‘Bebas Neue’; font-size: 64px; color: var(–borda);
line-height: 1; margin-bottom: 20px;
transition: color 0.3s;
}
.how-card:hover .how-num { color: var(–verde); }

.how-icon { font-size: 32px; margin-bottom: 16px; }

.how-title {
font-size: 18px; font-weight: 700; color: var(–branco);
margin-bottom: 10px;
}

.how-desc { font-size: 14px; color: var(–cinza-claro); line-height: 1.6; }

/* MODELOS */
.modelos-grid {
display: grid; grid-template-columns: repeat(3, 1fr);
gap: 20px; margin-top: 56px;
}

.modelo-card {
border-radius: 16px;
padding: 36px;
position: relative; overflow: hidden;
cursor: pointer;
transition: transform 0.3s;
}
.modelo-card:hover { transform: translateY(-6px); }

.modelo-card::before {
content: ‘’;
position: absolute; inset: 0;
background: inherit; z-index: 0;
transition: opacity 0.3s;
}

.modelo-1 { background: linear-gradient(135deg, #1a3a24 0%, #0d2015 100%); border: 1px solid rgba(45,206,92,0.2); }
.modelo-2 { background: linear-gradient(135deg, #2a1f14 0%, #1a1208 100%); border: 1px solid rgba(212,98,42,0.2); }
.modelo-3 { background: linear-gradient(135deg, #141a2a 0%, #0a0f1a 100%); border: 1px solid rgba(74,122,212,0.2); }

.modelo-card > * { position: relative; z-index: 1; }

.modelo-badge {
display: inline-block;
padding: 4px 12px; border-radius: 20px;
font-size: 11px; font-weight: 700; letter-spacing: 1px;
text-transform: uppercase; margin-bottom: 24px;
}
.modelo-1 .modelo-badge { background: rgba(45,206,92,0.15); color: var(–verde-neon); }
.modelo-2 .modelo-badge { background: rgba(212,98,42,0.15); color: #f08a5a; }
.modelo-3 .modelo-badge { background: rgba(74,122,212,0.15); color: #7aabf0; }

.modelo-title { font-size: 22px; font-weight: 700; color: var(–branco); margin-bottom: 12px; }
.modelo-desc { font-size: 14px; color: var(–cinza-claro); line-height: 1.6; margin-bottom: 24px; }

.modelo-features { display: flex; flex-direction: column; gap: 8px; }
.feat-item {
display: flex; align-items: center; gap: 8px;
font-size: 13px; color: var(–cinza-claro);
}
.feat-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.modelo-1 .feat-dot { background: var(–verde-neon); }
.modelo-2 .feat-dot { background: #f08a5a; }
.modelo-3 .feat-dot { background: #7aabf0; }

/* DASHBOARD DEMO */
.dashboard-section { background: var(–carvao); }

.dashboard-demo {
margin-top: 56px;
background: var(–superficie);
border: 1px solid var(–borda);
border-radius: 20px;
overflow: hidden;
}

.dash-topbar {
display: flex; align-items: center; justify-content: space-between;
padding: 16px 24px;
background: var(–card);
border-bottom: 1px solid var(–borda);
}

.dash-dots { display: flex; gap: 6px; }
.dash-dot { width: 12px; height: 12px; border-radius: 50%; }

.dash-title-bar {
font-size: 13px; color: var(–cinza); font-family: ‘Space Mono’;
}

.dash-user {
display: flex; align-items: center; gap: 8px;
font-size: 13px; color: var(–cinza-claro);
}
.user-av {
width: 28px; height: 28px; border-radius: 50%;
background: var(–verde);
display: flex; align-items: center; justify-content: center;
font-size: 11px; font-weight: 700; color: white;
}

.dash-body { display: grid; grid-template-columns: 220px 1fr; min-height: 560px; }

.dash-sidebar {
background: rgba(17,20,16,0.6);
border-right: 1px solid var(–borda);
padding: 24px 0;
}

.sidebar-section {
font-size: 10px; font-weight: 700; letter-spacing: 1.5px;
color: var(–cinza); text-transform: uppercase;
padding: 0 20px; margin-bottom: 8px; margin-top: 20px;
}

.sidebar-item {
display: flex; align-items: center; gap: 10px;
padding: 10px 20px; cursor: pointer;
font-size: 13px; color: var(–cinza-claro);
transition: all 0.2s;
border-left: 3px solid transparent;
}
.sidebar-item:hover, .sidebar-item.active {
background: rgba(45,206,92,0.08);
color: var(–verde-neon);
border-left-color: var(–verde-neon);
}
.sidebar-item span { font-size: 16px; }

.dash-main { padding: 28px; overflow: auto; }

.kpi-row {
display: grid; grid-template-columns: repeat(4, 1fr);
gap: 14px; margin-bottom: 24px;
}

.kpi-card {
background: var(–card);
border: 1px solid var(–borda);
border-radius: 12px; padding: 20px;
}

.kpi-label { font-size: 11px; color: var(–cinza); font-weight: 600; letter-spacing: 0.5px; margin-bottom: 8px; }
.kpi-value { font-family: ‘Bebas Neue’; font-size: 32px; line-height: 1; color: var(–branco); margin-bottom: 4px; }
.kpi-delta {
font-size: 11px; font-weight: 700;
display: flex; align-items: center; gap: 3px;
}
.kpi-delta.up { color: var(–verde-neon); }
.kpi-delta.down { color: var(–laranja); }

.dash-mid { display: grid; grid-template-columns: 1fr 280px; gap: 16px; }

.materiais-table {
background: var(–card);
border: 1px solid var(–borda);
border-radius: 12px; overflow: hidden;
}

.table-header {
display: flex; align-items: center; justify-content: space-between;
padding: 16px 20px;
border-bottom: 1px solid var(–borda);
}
.table-title { font-size: 14px; font-weight: 700; color: var(–branco); }
.table-badge {
background: rgba(45,206,92,0.1); color: var(–verde-neon);
border: 1px solid rgba(45,206,92,0.2);
padding: 3px 10px; border-radius: 10px;
font-size: 11px; font-weight: 700;
}

table { width: 100%; border-collapse: collapse; }
thead th {
text-align: left; padding: 12px 16px;
font-size: 10px; font-weight: 700; letter-spacing: 1px;
color: var(–cinza); text-transform: uppercase;
background: rgba(0,0,0,0.2);
border-bottom: 1px solid var(–borda);
}
tbody tr { border-bottom: 1px solid rgba(255,255,255,0.04); transition: background 0.15s; cursor: pointer; }
tbody tr:hover { background: rgba(45,206,92,0.05); }
tbody td { padding: 12px 16px; font-size: 13px; color: var(–cinza-claro); }
tbody td:first-child { color: var(–branco); font-weight: 600; }

.status-badge {
display: inline-block; padding: 3px 10px;
border-radius: 10px; font-size: 11px; font-weight: 700;
}
.status-disponivel { background: rgba(45,206,92,0.12); color: var(–verde-neon); }
.status-reservado { background: rgba(232,184,75,0.12); color: var(–amarelo); }
.status-negociando { background: rgba(212,98,42,0.12); color: #f08a5a; }
.status-vendido { background: rgba(122,128,112,0.12); color: var(–cinza-claro); }

/* PANEL LATERAL DASHBOARD */
.side-panel { display: flex; flex-direction: column; gap: 16px; }

.rfm-card {
background: var(–card);
border: 1px solid var(–borda);
border-radius: 12px; padding: 20px;
}
.panel-title { font-size: 13px; font-weight: 700; color: var(–branco); margin-bottom: 14px; }

.rfm-item {
display: flex; justify-content: space-between; align-items: center;
padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05);
}
.rfm-item:last-child { border-bottom: none; }
.rfm-label { font-size: 13px; color: var(–cinza-claro); }
.rfm-score { font-family: ‘Space Mono’; font-size: 13px; font-weight: 700; }
.rfm-a { color: var(–verde-neon); }
.rfm-b { color: var(–amarelo); }
.rfm-c { color: var(–laranja); }

.bar-item { margin-bottom: 12px; }
.bar-label { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 5px; color: var(–cinza-claro); }
.bar-track { height: 6px; background: var(–borda); border-radius: 3px; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 3px; transition: width 1s ease; }

/* CAPTAÇÃO */
.captacao-section { background: var(–superficie); }

.captacao-grid {
display: grid; grid-template-columns: 1fr 1fr;
gap: 48px; margin-top: 60px; align-items: center;
}

.captacao-visual {
background: var(–card);
border: 1px solid var(–borda);
border-radius: 20px; padding: 36px;
}

.funnel { display: flex; flex-direction: column; align-items: center; gap: 0; }

.funnel-step {
width: 100%;
display: flex; flex-direction: column; align-items: center;
position: relative;
}

.funnel-bar {
height: 52px; border-radius: 6px;
display: flex; align-items: center; justify-content: space-between;
padding: 0 20px;
font-size: 13px; font-weight: 700;
transition: all 0.3s;
cursor: pointer;
}
.funnel-bar:hover { filter: brightness(1.2); }

.funnel-arrow {
font-size: 18px; color: var(–cinza); margin: 4px 0;
text-align: center;
}

.f1 { background: rgba(45,206,92,0.25); color: var(–verde-neon); width: 100%; }
.f2 { background: rgba(45,206,92,0.2); color: var(–verde-neon); width: 88%; }
.f3 { background: rgba(232,184,75,0.2); color: var(–amarelo); width: 74%; }
.f4 { background: rgba(212,98,42,0.2); color: #f08a5a; width: 60%; }
.f5 { background: rgba(26,122,60,0.4); color: var(–verde-neon); width: 46%; }

.funnel-pct {
font-family: ‘Space Mono’; font-size: 11px; font-weight: 700; opacity: 0.7;
}

.captacao-features { display: flex; flex-direction: column; gap: 28px; }

.feat-row {
display: flex; gap: 16px; align-items: flex-start;
}
.feat-icon-box {
width: 44px; height: 44px; flex-shrink: 0;
background: rgba(26,122,60,0.15);
border: 1px solid rgba(45,206,92,0.2);
border-radius: 10px;
display: flex; align-items: center; justify-content: center;
font-size: 20px;
}
.feat-text-title { font-size: 16px; font-weight: 700; color: var(–branco); margin-bottom: 4px; }
.feat-text-desc { font-size: 13px; color: var(–cinza-claro); line-height: 1.5; }

/* PÚBLICO */
.publico-section { background: var(–carvao); }

.publico-grid {
display: grid; grid-template-columns: repeat(4, 1fr);
gap: 16px; margin-top: 56px;
}

.publico-card {
background: var(–card);
border: 1px solid var(–borda);
border-radius: 14px; padding: 28px 22px;
text-align: center;
transition: all 0.3s; cursor: default;
}
.publico-card:hover {
border-color: rgba(45,206,92,0.3);
background: rgba(26,122,60,0.12);
transform: translateY(-4px);
}

.pub-icon { font-size: 36px; margin-bottom: 14px; display: block; }
.pub-title { font-size: 15px; font-weight: 700; color: var(–branco); margin-bottom: 6px; }
.pub-sub { font-size: 12px; color: var(–cinza); line-height: 1.5; }

.pub-tag {
display: inline-block; margin-top: 12px;
background: rgba(45,206,92,0.1); color: var(–verde-neon);
border: 1px solid rgba(45,206,92,0.2);
padding: 3px 10px; border-radius: 10px;
font-size: 11px; font-weight: 700;
}

/* LEILÃO */
.leilao-section { background: var(–superficie); }

.leilao-grid {
display: grid; grid-template-columns: repeat(3, 1fr);
gap: 20px; margin-top: 56px;
}

.leilao-card {
background: var(–card);
border: 1px solid var(–borda);
border-radius: 16px; overflow: hidden;
transition: all 0.3s;
}
.leilao-card:hover { border-color: rgba(45,206,92,0.3); transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); }

.leilao-img {
height: 160px;
display: flex; align-items: center; justify-content: center;
font-size: 72px; position: relative; overflow: hidden;
}

.leilao-img-1 { background: linear-gradient(135deg, #2a1c10, #3a2818); }
.leilao-img-2 { background: linear-gradient(135deg, #1a2a1a, #0d1a0d); }
.leilao-img-3 { background: linear-gradient(135deg, #1a1a2a, #0d0d1a); }

.leilao-tipo {
position: absolute; top: 12px; left: 12px;
background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);
padding: 4px 10px; border-radius: 6px;
font-size: 11px; font-weight: 700; letter-spacing: 0.5px;
}

.leilao-urgente { color: #f08a5a; border: 1px solid rgba(212,98,42,0.4); }
.leilao-novo { color: var(–verde-neon); border: 1px solid rgba(45,206,92,0.4); }
.leilao-encerrar { color: var(–amarelo); border: 1px solid rgba(232,184,75,0.4); }

.leilao-body { padding: 20px; }
.leilao-title { font-size: 15px; font-weight: 700; color: var(–branco); margin-bottom: 6px; }
.leilao-meta { font-size: 12px; color: var(–cinza); margin-bottom: 16px; }

.leilao-bids {
display: flex; justify-content: space-between;
border-top: 1px solid var(–borda); padding-top: 14px; margin-top: 14px;
}

.bid-label { font-size: 11px; color: var(–cinza); margin-bottom: 4px; }
.bid-value { font-family: ‘Space Mono’; font-size: 16px; font-weight: 700; color: var(–verde-neon); }
.bid-value.small { font-size: 13px; color: var(–cinza-claro); }

.timer {
display: flex; gap: 6px; margin-top: 14px;
}
.timer-unit {
background: rgba(0,0,0,0.4); border: 1px solid var(–borda);
border-radius: 6px; padding: 6px 10px; text-align: center;
flex: 1;
}
